# API Configuration
# Local dev (matches the Vite dev server proxy target in vite.config.ts): http://localhost:3001/api
# Docker build: overridden via `--build-arg VITE_API_URL=/api` (relative, same-origin through nginx)
VITE_API_URL=http://localhost:3001/api

# Legacy Supabase (remove after migration)
# VITE_SUPABASE_URL=https://myvmqncragvxfmwztnml.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im15dm1xbmNyYWd2eGZtd3p0bm1sIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTQ4MTg0NDgsImV4cCI6MjA3MDM5NDQ0OH0.PMfgbSwQxR96Xw1vWk0G6FeccmA6rjnNqCNKL7XstoE

# Inactivity session timeout (signed-in users only)
# Minutes of no activity before the user is signed out automatically. Default: 30. Set 0 to disable.
# VITE_IDLE_TIMEOUT_MINUTES=30
# Seconds of on-screen "You will be signed out in ..." warning before that happens. Default: 60.
# Set 0 to sign out without a warning. Capped at the timeout length.
# VITE_IDLE_WARNING_SECONDS=60
# NOTE: these are build-time values (Vite inlines them). For Docker builds pass them as
# --build-arg / ARG like VITE_API_URL. The JWT lifetime is separate and server-side
# (JWT_EXPIRES_IN in backend/.env, default 7d).
