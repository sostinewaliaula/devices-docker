# Database Configuration
# Choose: mysql | mariadb | postgres
DB_CLIENT=mariadb
# Local dev: localhost | Docker Compose: db (the service name)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_password_here
DB_NAME=assets_management
# Only used by the docker-compose db service to set the MariaDB root password
DB_ROOT_PASSWORD=change_me_root_password
# Set to true if your provider requires SSL
DB_SSL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development
TZ=Africa/Nairobi

# CORS Configuration
# Primary allowed frontend origin
FRONTEND_URL=http://localhost:5173
# Optional extra allowed origins, comma-separated
FRONTEND_URLS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SMTP Configuration (used for email notifications, backups, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM=no-reply@example.com

BRAND_NAME="Your Company Assets"

# Google OAuth
# Get these from https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Restrict Google sign-in to a specific email domain. Leave empty to allow any Google account.
GOOGLE_ALLOWED_DOMAIN=
